# Copy this file to .env and fill in your own values. .env is gitignored.

# Alpaca market data (https://alpaca.markets). Paper-trading keys work.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data provider: alpaca (default) or schwab. Any other provider can be added by
# implementing scanner/data/interface.py; see "Adding a data provider" in USER_GUIDE.md.
DATA_PROVIDER=alpaca

# The dashboard API accepts only requests addressed to this machine. If you
# deliberately serve it on a LAN, list every DNS name/IP your browser will use.
# There is no login; only use this on a trusted network.
# SCANNER_ALLOWED_HOSTS=192.168.1.20,trading-pc

# Charles Schwab (only for DATA_PROVIDER=schwab). Create an app at
# https://developer.schwab.com, then log in once: python scripts/schwab_auth.py
# (the login expires after 7 days; run it again weekly).
# SCHWAB_APP_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1
# Schwab streams real 1-minute bars for 300 symbols; past that the scanner builds bars from
# Schwab's quotes so the whole universe is covered. Set to 0 to scan only the first 300.
# SCHWAB_SYNTHETIC_BARS=1

# sip (default): the consolidated tape, needs a paid Alpaca market-data plan.
# iex: free, but a single exchange, so volume and RVOL read far lower and the
# volume-based setups fire much less.
ALPACA_FEED=sip

# News window: keyless per-symbol RSS feeds merged with Alpaca news.
# Comma-separated, any of: yahoo,nasdaq. Empty = Alpaca news only.
# NEWS_RSS_SOURCES=yahoo,nasdaq
